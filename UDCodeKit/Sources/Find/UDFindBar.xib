<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="24127" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="NO" customObjectInstantitationMethod="direct">
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="24127"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="UDFindBarViewController">
            <connections>
                <outlet property="view" destination="FB-root" id="FB-o-view"/>
                <outlet property="modeControl" destination="FB-mode" id="FB-o-mode"/>
                <outlet property="findField" destination="FB-find" id="FB-o-find"/>
                <outlet property="statusLabel" destination="FB-status" id="FB-o-status"/>
                <outlet property="navigationControl" destination="FB-nav" id="FB-o-nav"/>
                <outlet property="matchCaseButton" destination="FB-case" id="FB-o-case"/>
                <outlet property="wholeWordButton" destination="FB-word" id="FB-o-word"/>
                <outlet property="regexButton" destination="FB-regex" id="FB-o-regex"/>
                <outlet property="doneButton" destination="FB-done" id="FB-o-done"/>
                <outlet property="replaceRow" destination="FB-replace-row" id="FB-o-row"/>
                <outlet property="replaceField" destination="FB-replace" id="FB-o-replace"/>
                <outlet property="replaceButton" destination="FB-replace-one" id="FB-o-replace-one"/>
                <outlet property="replaceAllButton" destination="FB-replace-all" id="FB-o-replace-all"/>
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application" customClass="NSObject"/>
        <customView id="FB-root" userLabel="Find Bar">
            <rect key="frame" x="0.0" y="0.0" width="900" height="56"/>
            <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMinY="YES"/>
            <subviews>
                <segmentedControl verticalHuggingPriority="750" id="FB-mode" userLabel="Find or Replace">
                    <rect key="frame" x="6" y="29" width="134" height="24"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                    <segmentedCell key="cell" borderStyle="border" alignment="left" style="rounded" trackingMode="selectOne" id="FB-mode-cell">
                        <font key="font" metaFont="system"/>
                        <segments>
                            <segment label="Find" width="62" selected="YES"/>
                            <segment label="Replace" width="66" tag="1"/>
                        </segments>
                    </segmentedCell>
                    <connections>
                        <action selector="modeChanged:" target="-2" id="FB-a-mode"/>
                    </connections>
                </segmentedControl>
                <searchField wantsLayer="YES" verticalHuggingPriority="750" textCompletion="NO" id="FB-find" userLabel="Find Field">
                    <rect key="frame" x="146" y="30" width="414" height="22"/>
                    <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMinY="YES"/>
                    <searchFieldCell key="cell" scrollable="YES" lineBreakMode="clipping" selectable="YES" editable="YES" borderStyle="bezel" placeholderString="Find" usesSingleLineMode="YES" bezelStyle="round" sendsSearchStringImmediately="YES" id="FB-find-cell">
                        <font key="font" metaFont="system"/>
                        <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                        <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                    </searchFieldCell>
                    <connections>
                        <action selector="findFieldChanged:" target="-2" id="FB-a-find"/>
                        <outlet property="delegate" destination="-2" id="FB-d-find"/>
                    </connections>
                </searchField>
                <textField verticalHuggingPriority="750" id="FB-status" userLabel="Status">
                    <rect key="frame" x="564" y="33" width="84" height="16"/>
                    <autoresizingMask key="autoresizingMask" flexibleMinX="YES" flexibleMinY="YES"/>
                    <textFieldCell key="cell" lineBreakMode="truncatingTail" alignment="right" title="" id="FB-status-cell">
                        <font key="font" metaFont="smallSystem"/>
                        <color key="textColor" name="secondaryLabelColor" catalog="System" colorSpace="catalog"/>
                        <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                    </textFieldCell>
                </textField>
                <segmentedControl verticalHuggingPriority="750" id="FB-nav" userLabel="Previous and Next">
                    <rect key="frame" x="652" y="29" width="58" height="24"/>
                    <autoresizingMask key="autoresizingMask" flexibleMinX="YES" flexibleMinY="YES"/>
                    <segmentedCell key="cell" borderStyle="border" alignment="left" style="rounded" trackingMode="momentary" id="FB-nav-cell">
                        <font key="font" metaFont="system"/>
                        <segments>
                            <segment label="&lt;" toolTip="Previous match (Shift-Command-G)" width="25"/>
                            <segment label="&gt;" toolTip="Next match (Command-G)" width="25" tag="1"/>
                        </segments>
                    </segmentedCell>
                    <connections>
                        <action selector="navigate:" target="-2" id="FB-a-nav"/>
                    </connections>
                </segmentedControl>
                <button verticalHuggingPriority="750" id="FB-case" userLabel="Match Case">
                    <rect key="frame" x="714" y="29" width="30" height="24"/>
                    <autoresizingMask key="autoresizingMask" flexibleMinX="YES" flexibleMinY="YES"/>
                    <buttonCell key="cell" type="smallSquare" title="Aa" bezelStyle="smallSquare" alignment="center" lineBreakMode="truncatingTail" state="off" borderStyle="border" inset="2" id="FB-case-cell">
                        <behavior key="behavior" pushIn="YES" changeContents="YES" lightByContents="YES"/>
                        <font key="font" metaFont="smallSystem"/>
                    </buttonCell>
                    <string key="toolTip">Match case</string>
                    <connections>
                        <action selector="optionsChanged:" target="-2" id="FB-a-case"/>
                    </connections>
                </button>
                <button verticalHuggingPriority="750" id="FB-word" userLabel="Whole Word">
                    <rect key="frame" x="746" y="29" width="30" height="24"/>
                    <autoresizingMask key="autoresizingMask" flexibleMinX="YES" flexibleMinY="YES"/>
                    <buttonCell key="cell" type="smallSquare" title="W" bezelStyle="smallSquare" alignment="center" lineBreakMode="truncatingTail" state="off" borderStyle="border" inset="2" id="FB-word-cell">
                        <behavior key="behavior" pushIn="YES" changeContents="YES" lightByContents="YES"/>
                        <font key="font" metaFont="smallSystem"/>
                    </buttonCell>
                    <string key="toolTip">Whole words only</string>
                    <connections>
                        <action selector="optionsChanged:" target="-2" id="FB-a-word"/>
                    </connections>
                </button>
                <button verticalHuggingPriority="750" id="FB-regex" userLabel="Regular Expression">
                    <rect key="frame" x="778" y="29" width="30" height="24"/>
                    <autoresizingMask key="autoresizingMask" flexibleMinX="YES" flexibleMinY="YES"/>
                    <buttonCell key="cell" type="smallSquare" title=".*" bezelStyle="smallSquare" alignment="center" lineBreakMode="truncatingTail" state="off" borderStyle="border" inset="2" id="FB-regex-cell">
                        <behavior key="behavior" pushIn="YES" changeContents="YES" lightByContents="YES"/>
                        <font key="font" metaFont="smallSystem"/>
                    </buttonCell>
                    <string key="toolTip">Regular expression</string>
                    <connections>
                        <action selector="optionsChanged:" target="-2" id="FB-a-regex"/>
                    </connections>
                </button>
                <button verticalHuggingPriority="750" id="FB-done" userLabel="Done">
                    <rect key="frame" x="814" y="27" width="80" height="28"/>
                    <autoresizingMask key="autoresizingMask" flexibleMinX="YES" flexibleMinY="YES"/>
                    <buttonCell key="cell" type="push" title="Done" bezelStyle="rounded" alignment="center" borderStyle="border" imageScaling="proportionallyDown" inset="2" id="FB-done-cell">
                        <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES"/>
                        <font key="font" metaFont="system"/>
                        <string key="keyEquivalent" base64-UTF8="YES">
Gw
</string>
                    </buttonCell>
                    <connections>
                        <action selector="done:" target="-2" id="FB-a-done"/>
                    </connections>
                </button>
                <customView hidden="YES" id="FB-replace-row" userLabel="Replace Row">
                    <rect key="frame" x="0.0" y="0.0" width="900" height="28"/>
                    <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMaxY="YES"/>
                    <subviews>
                        <textField verticalHuggingPriority="750" id="FB-replace" userLabel="Replace Field">
                            <rect key="frame" x="146" y="3" width="414" height="22"/>
                            <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMaxY="YES"/>
                            <textFieldCell key="cell" scrollable="YES" lineBreakMode="clipping" selectable="YES" editable="YES" sendsActionOnEndEditing="YES" borderStyle="bezel" placeholderString="Replace" drawsBackground="YES" usesSingleLineMode="YES" id="FB-replace-cell">
                                <font key="font" metaFont="system"/>
                                <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                                <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                            </textFieldCell>
                            <connections>
                                <outlet property="delegate" destination="-2" id="FB-d-replace"/>
                            </connections>
                        </textField>
                        <button verticalHuggingPriority="750" id="FB-replace-one" userLabel="Replace">
                            <rect key="frame" x="562" y="0.0" width="90" height="28"/>
                            <autoresizingMask key="autoresizingMask" flexibleMinX="YES" flexibleMaxY="YES"/>
                            <buttonCell key="cell" type="push" title="Replace" bezelStyle="rounded" alignment="center" borderStyle="border" imageScaling="proportionallyDown" inset="2" id="FB-replace-one-cell">
                                <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES"/>
                                <font key="font" metaFont="system"/>
                            </buttonCell>
                            <connections>
                                <action selector="replace:" target="-2" id="FB-a-replace-one"/>
                            </connections>
                        </button>
                        <button verticalHuggingPriority="750" id="FB-replace-all" userLabel="Replace All">
                            <rect key="frame" x="652" y="0.0" width="66" height="28"/>
                            <autoresizingMask key="autoresizingMask" flexibleMinX="YES" flexibleMaxY="YES"/>
                            <buttonCell key="cell" type="push" title="All" bezelStyle="rounded" alignment="center" borderStyle="border" imageScaling="proportionallyDown" inset="2" id="FB-replace-all-cell">
                                <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES"/>
                                <font key="font" metaFont="system"/>
                            </buttonCell>
                            <string key="toolTip">Replace all matches</string>
                            <connections>
                                <action selector="replaceAll:" target="-2" id="FB-a-replace-all"/>
                            </connections>
                        </button>
                    </subviews>
                </customView>
            </subviews>
            <point key="canvasLocation" x="200" y="100"/>
        </customView>
    </objects>
</document>

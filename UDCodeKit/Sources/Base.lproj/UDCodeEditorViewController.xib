<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="24127" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="NO" customObjectInstantitationMethod="direct">
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="24127"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="UDCodeEditorViewController">
            <connections>
                <outlet property="view" destination="TE-container-view" id="TE-view-outlet"/>
                <outlet property="findBarHost" destination="TE-find-host" id="TE-find-host-outlet"/>
                <outlet property="editorArea" destination="TE-editor-area" id="TE-editor-area-outlet"/>
                <outlet property="lineNumberGutterView" destination="TE-line-gutter" id="TE-line-gutter-outlet"/>
                <outlet property="scrollView" destination="TE-scroll-view" id="TE-scroll-outlet"/>
                <outlet property="textView" destination="TE-text-view" id="TE-text-outlet"/>
                <outlet property="gutterView" destination="TE-results-gutter" id="TE-results-gutter-outlet"/>
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application" customClass="NSObject"/>
        <customView id="TE-container-view" userLabel="Editor">
            <rect key="frame" x="0.0" y="0.0" width="900" height="600"/>
            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
            <subviews>
                <customView hidden="YES" id="TE-find-host" userLabel="Find Bar Host">
                    <rect key="frame" x="0.0" y="570" width="900" height="30"/>
                    <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMinY="YES"/>
                </customView>
                <customView id="TE-editor-area" userLabel="Editor Area">
                    <rect key="frame" x="0.0" y="0.0" width="900" height="600"/>
                    <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                    <subviews>
                        <customView id="TE-line-gutter" userLabel="Line Numbers" customClass="UDLineNumberGutterView">
                            <rect key="frame" x="0.0" y="0.0" width="48" height="600"/>
                            <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" heightSizable="YES"/>
                            <connections>
                                <outlet property="delegate" destination="-2" id="TE-line-gutter-delegate"/>
                            </connections>
                        </customView>
                        <scrollView borderType="none" horizontalLineScroll="10" horizontalPageScroll="10" verticalLineScroll="10" verticalPageScroll="10" hasHorizontalScroller="NO" id="TE-scroll-view">
                            <rect key="frame" x="48" y="0.0" width="840" height="600"/>
                            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                            <clipView key="contentView" drawsBackground="NO" id="TE-clip-view">
                                <rect key="frame" x="0.0" y="0.0" width="825" height="600"/>
                                <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                                <subviews>
                                    <textView wantsLayer="YES" importsGraphics="NO" richText="NO" verticallyResizable="YES" allowsUndo="NO" smartInsertDelete="YES" id="TE-text-view" customClass="UDDiagnosticTextView">
                                        <rect key="frame" x="0.0" y="0.0" width="825" height="600"/>
                                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                                        <color key="textColor" name="textColor" catalog="System" colorSpace="catalog"/>
                                        <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                                        <size key="minSize" width="825" height="600"/>
                                        <size key="maxSize" width="10000000" height="10000000"/>
                                    </textView>
                                </subviews>
                            </clipView>
                            <scroller key="horizontalScroller" hidden="YES" verticalHuggingPriority="750" horizontal="YES" id="TE-hscroll">
                                <rect key="frame" x="-100" y="-100" width="225" height="15"/>
                                <autoresizingMask key="autoresizingMask"/>
                            </scroller>
                            <scroller key="verticalScroller" verticalHuggingPriority="750" horizontal="NO" id="TE-vscroll">
                                <rect key="frame" x="825" y="0.0" width="15" height="600"/>
                                <autoresizingMask key="autoresizingMask"/>
                            </scroller>
                        </scrollView>
                        <customView id="TE-results-gutter" userLabel="Matches and Errors" customClass="UDFindResultsGutterView">
                            <rect key="frame" x="888" y="0.0" width="12" height="600"/>
                            <autoresizingMask key="autoresizingMask" flexibleMinX="YES" heightSizable="YES"/>
                        </customView>
                    </subviews>
                </customView>
            </subviews>
            <point key="canvasLocation" x="200" y="200"/>
        </customView>
    </objects>
</document>

# What UDCodeKit and UDCode build on, by the exact versions of their
# releases: gnustep-release-actions' workflows (scripts/deps.sh) fetch them
# from here. To move one, edit it here.
#   Linux  each one's archive, unpacked into /opt/gnustep, the stack first
#   Apple  Sparkle's XCFramework, unpacked into .deps/

# The patched GNUstep stack (ashalkhakov/gnustep-patches).
GNUSTEP_PATCHES_VERSION=2026.10.14.5
# UDCode's updates on macOS.
SPARKLE_VERSION=2.10.0

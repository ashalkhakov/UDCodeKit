                                    </textField>
                                </subviews>
                            </customView>
                        </subviews>
                        <holdingPriorities>
                            <real value="260"/>
                            <real value="250"/>
                            <real value="260"/>
                        </holdingPriorities>
                    </splitView>
                </subviews>
            </view>
            <connections>
                <outlet property="delegate" destination="-2" id="WS-o-window-delegate"/>
            </connections>
            <point key="canvasLocation" x="200" y="200"/>
        </window>
    </objects>
</document>

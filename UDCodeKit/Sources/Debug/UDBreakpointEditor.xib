<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="24127" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="NO" customObjectInstantitationMethod="direct">
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="24127"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="UDBreakpointEditorViewController">
            <connections>
                <outlet property="view" destination="BE-root" id="BE-o-view"/>
                <outlet property="kindPopUp" destination="BE-kind" id="BE-o-kind"/>
                <outlet property="field" destination="BE-field" id="BE-o-field"/>
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application" customClass="NSObject"/>
        <customView id="BE-root" userLabel="Breakpoint Editor" customClass="UDBreakpointEditorBox">
            <rect key="frame" x="0.0" y="0.0" width="480" height="34"/>
            <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
            <subviews>
                <popUpButton verticalHuggingPriority="750" id="BE-kind" userLabel="Expression, Hit Count or Log Message">
                    <rect key="frame" x="6" y="5" width="122" height="24"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES"/>
                    <popUpButtonCell key="cell" type="push" title="Expression" bezelStyle="rounded" alignment="left" controlSize="small" lineBreakMode="truncatingTail" state="on" borderStyle="borderAndBezel" tag="0" imageScaling="proportionallyDown" inset="2" selectedItem="BE-kind-condition" id="BE-kind-cell">
                        <behavior key="behavior" lightByBackground="YES" lightByGray="YES"/>
                        <font key="font" metaFont="smallSystem"/>
                        <menu key="menu" autoenablesItems="NO" id="BE-kind-menu">
                            <items>
                                <menuItem title="Expression" state="on" id="BE-kind-condition"/>
                                <menuItem title="Hit Count" tag="1" id="BE-kind-hit"/>
                                <menuItem title="Log Message" tag="2" id="BE-kind-log"/>
                            </items>
                        </menu>
                    </popUpButtonCell>
                    <connections>
                        <action selector="kindChanged:" target="-2" id="BE-a-kind"/>
                    </connections>
                </popUpButton>
                <textField focusRingType="none" verticalHuggingPriority="750" id="BE-field" userLabel="Condition, Hit Count or Message">
                    <rect key="frame" x="134" y="6" width="338" height="22"/>
                    <autoresizingMask key="autoresizingMask" widthSizable="YES"/>
                    <textFieldCell key="cell" scrollable="YES" lineBreakMode="clipping" selectable="YES" editable="YES" sendsActionOnEndEditing="NO" borderStyle="bezel" placeholderString="Break when the expression evaluates to true" drawsBackground="YES" usesSingleLineMode="YES" id="BE-field-cell">
                        <font key="font" metaFont="system"/>
                        <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                        <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                    </textFieldCell>
                    <connections>
                        <action selector="accept:" target="-2" id="BE-a-accept"/>
                        <outlet property="delegate" destination="-2" id="BE-o-delegate"/>
                    </connections>
                </textField>
            </subviews>
        </customView>
    </objects>
</document>

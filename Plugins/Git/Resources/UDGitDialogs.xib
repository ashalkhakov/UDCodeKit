<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="24127" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="NO" customObjectInstantitationMethod="direct">
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="24127"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="UDGitAccessories">
            <connections>
                <outlet property="field" destination="GD-field" id="GD-o-field"/>
                <outlet property="checkBox" destination="GD-check" id="GD-o-check"/>
                <outlet property="pushView" destination="GD-push" id="GD-o-push"/>
                <outlet property="remotesButton" destination="GD-push-remotes" id="GD-o-push-remotes"/>
                <outlet property="tagsCheckBox" destination="GD-push-tags" id="GD-o-push-tags"/>
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application" customClass="NSObject"/>
        <textField verticalHuggingPriority="750" id="GD-field" userLabel="Name, Address or Description">
            <rect key="frame" x="0.0" y="0.0" width="300" height="22"/>
            <autoresizingMask key="autoresizingMask" widthSizable="YES"/>
            <textFieldCell key="cell" scrollable="YES" lineBreakMode="clipping" selectable="YES" editable="YES" sendsActionOnEndEditing="YES" borderStyle="bezel" drawsBackground="YES" id="GD-field-cell">
                <font key="font" metaFont="system"/>
                <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
            </textFieldCell>
            <point key="canvasLocation" x="200" y="100"/>
        </textField>
        <button verticalHuggingPriority="750" id="GD-check" userLabel="Option (its title the question's)">
            <rect key="frame" x="0.0" y="0.0" width="300" height="18"/>
            <autoresizingMask key="autoresizingMask" widthSizable="YES"/>
            <buttonCell key="cell" type="check" title="Option" bezelStyle="regularSquare" imagePosition="left" inset="2" id="GD-check-cell">
                <behavior key="behavior" changeContents="YES" doesNotDimImage="YES" lightByContents="YES"/>
                <font key="font" metaFont="system"/>
            </buttonCell>
            <point key="canvasLocation" x="200" y="160"/>
        </button>
        <customView id="GD-push" userLabel="Push: Remote, Include Tags">
            <rect key="frame" x="0.0" y="0.0" width="260" height="52"/>
            <autoresizingMask key="autoresizingMask" widthSizable="YES"/>
            <subviews>
                <popUpButton verticalHuggingPriority="750" id="GD-push-remotes" userLabel="Remote">
                    <rect key="frame" x="-2" y="26" width="264" height="25"/>
                    <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMinY="YES"/>
                    <popUpButtonCell key="cell" type="push" bezelStyle="rounded" alignment="left" lineBreakMode="truncatingTail" borderStyle="borderAndBezel" imageScaling="proportionallyDown" inset="2" id="GD-push-remotes-cell">
                        <behavior key="behavior" lightByBackground="YES" lightByGray="YES"/>
                        <font key="font" metaFont="system"/>
                        <menu key="menu" id="GD-push-remotes-menu"/>
                    </popUpButtonCell>
                </popUpButton>
                <button verticalHuggingPriority="750" id="GD-push-tags" userLabel="Include Tags">
                    <rect key="frame" x="0.0" y="2" width="260" height="18"/>
                    <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMaxY="YES"/>
                    <buttonCell key="cell" type="check" title="Include tags" bezelStyle="regularSquare" imagePosition="left" inset="2" id="GD-push-tags-cell">
                        <behavior key="behavior" changeContents="YES" doesNotDimImage="YES" lightByContents="YES"/>
                        <font key="font" metaFont="system"/>
                    </buttonCell>
                </button>
            </subviews>
            <point key="canvasLocation" x="200" y="240"/>
        </customView>
    </objects>
</document>

                        </subviews>
                        <holdingPriorities>
                            <real value="260"/>
                            <real value="250"/>
                            <real value="260"/>
                        </holdingPriorities>
                    </splitView>
                </subviews>
            </view>
            <toolbar key="toolbar" implicitIdentifier="UDCode-Workspace-Toolbar" autosavesConfiguration="NO" allowsUserCustomization="NO" displayMode="iconOnly" sizeMode="regular" id="TB-toolbar">
                <allowedToolbarItems>
                    <toolbarItem implicitItemIdentifier="TB-navigator-ident" label="Navigator" paletteLabel="Navigator" toolTip="Hide or show the Navigator (⌘0)" image="sidebar.left" catalog="system" bordered="YES" id="TB-navigator">
                        <size key="minSize" width="36" height="28"/>
                        <size key="maxSize" width="36" height="28"/>
                        <connections>
                            <action selector="toggleNavigator:" target="-1" id="TB-navigator-a"/>
                        </connections>
                    </toolbarItem>
                    <toolbarItem implicitItemIdentifier="TB-run-ident" label="Run" paletteLabel="Run" toolTip="Build and run (⌘R)" image="play.fill" catalog="system" bordered="YES" id="TB-run">
                        <size key="minSize" width="36" height="28"/>
                        <size key="maxSize" width="36" height="28"/>
                        <connections>
                            <action selector="startDebugging:" target="-1" id="TB-run-a"/>
                        </connections>
                    </toolbarItem>
                    <toolbarItem implicitItemIdentifier="TB-stop-ident" label="Stop" paletteLabel="Stop" toolTip="Stop (⌘.)" image="stop.fill" catalog="system" bordered="YES" id="TB-stop">
                        <size key="minSize" width="36" height="28"/>
                        <size key="maxSize" width="36" height="28"/>
                        <connections>
                            <action selector="stopDebugging:" target="-1" id="TB-stop-a"/>
                        </connections>
                    </toolbarItem>
                    <toolbarItem implicitItemIdentifier="TB-scheme-ident" label="Scheme" paletteLabel="Scheme" toolTip="What Run runs: the project, or a launch configuration" id="TB-scheme">
                        <size key="minSize" width="120" height="25"/>
                        <size key="maxSize" width="220" height="25"/>
                        <popUpButton key="view" verticalHuggingPriority="750" id="TB-scheme-popup">
                            <rect key="frame" x="0.0" y="14" width="180" height="25"/>
                            <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                            <popUpButtonCell key="cell" type="roundTextured" title="Scheme" bezelStyle="texturedRounded" alignment="left" lineBreakMode="truncatingTail" borderStyle="border" imageScaling="proportionallyDown" inset="2" id="TB-scheme-cell">
                                <behavior key="behavior" lightByBackground="YES" lightByGray="YES"/>
                                <font key="font" metaFont="menu"/>
                                <menu key="menu" id="TB-scheme-menu"/>
                            </popUpButtonCell>
                        </popUpButton>
                    </toolbarItem>
                    <toolbarItem implicitItemIdentifier="NSToolbarFlexibleSpaceItem" id="TB-flex-1"/>
                    <toolbarItem implicitItemIdentifier="TB-activity-ident" label="Activity" paletteLabel="Activity" id="TB-activity">
                        <nil key="toolTip"/>
                        <size key="minSize" width="200" height="24"/>
                        <size key="maxSize" width="520" height="24"/>
                        <textField key="view" focusRingType="none" verticalHuggingPriority="750" id="TB-activity-label" userLabel="Activity">
                            <rect key="frame" x="0.0" y="14" width="420" height="24"/>
                            <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                            <textFieldCell key="cell" lineBreakMode="truncatingTail" alignment="center" title="Ready" drawsBackground="YES" usesSingleLineMode="YES" bezelStyle="round" id="TB-activity-cell">
                                <font key="font" metaFont="system"/>
                                <color key="textColor" name="labelColor" catalog="System" colorSpace="catalog"/>
                                <color key="backgroundColor" name="controlBackgroundColor" catalog="System" colorSpace="catalog"/>
                            </textFieldCell>
                        </textField>
                    </toolbarItem>
                    <toolbarItem implicitItemIdentifier="NSToolbarFlexibleSpaceItem" id="TB-flex-2"/>
                    <toolbarItem implicitItemIdentifier="TB-inspector-ident" label="Inspector" paletteLabel="Inspector" toolTip="Hide or show the Inspector (⌥⌘0)" image="sidebar.right" catalog="system" bordered="YES" id="TB-inspector">
                        <size key="minSize" width="36" height="28"/>
                        <size key="maxSize" width="36" height="28"/>
                        <connections>
                            <action selector="toggleInspector:" target="-1" id="TB-inspector-a"/>
                        </connections>
                    </toolbarItem>
                </allowedToolbarItems>
                <defaultToolbarItems>
                    <toolbarItem reference="TB-navigator"/>
                    <toolbarItem reference="TB-run"/>
                    <toolbarItem reference="TB-stop"/>
                    <toolbarItem reference="TB-scheme"/>
                    <toolbarItem reference="TB-flex-1"/>
                    <toolbarItem reference="TB-activity"/>
                    <toolbarItem reference="TB-flex-2"/>
                    <toolbarItem reference="TB-inspector"/>
                </defaultToolbarItems>
            </toolbar>
            <connections>
                <outlet property="delegate" destination="-2" id="WS-o-window-delegate"/>
            </connections>
            <point key="canvasLocation" x="200" y="200"/>
        </window>
    </objects>

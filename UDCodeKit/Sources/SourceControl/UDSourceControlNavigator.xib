<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="24127" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="NO" customObjectInstantitationMethod="direct">
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="24127"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="UDSourceControlNavigatorViewController">
            <connections>
                <outlet property="view" destination="SC-root" id="SC-o-view"/>
                <outlet property="tabsControl" destination="SC-tabs" id="SC-o-tabs"/>
                <outlet property="changesPane" destination="SC-changes" id="SC-o-changes"/>
                <outlet property="repositoriesPane" destination="SC-repositories" id="SC-o-repositories"/>
                <outlet property="statusLabel" destination="SC-status" id="SC-o-status"/>
                <outlet property="emptyLabel" destination="SC-empty" id="SC-o-empty"/>
                <outlet property="changesView" destination="SC-outline" id="SC-o-outline"/>
                <outlet property="messageField" destination="SC-message" id="SC-o-message"/>
                <outlet property="commitButton" destination="SC-commit" id="SC-o-commit"/>
                <outlet property="commitOptionsButton" destination="SC-options" id="SC-o-options"/>
                <outlet property="fileMenu" destination="SC-file-menu" id="SC-o-file-menu"/>
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application" customClass="NSObject"/>
        <menu title="Changes" autoenablesItems="YES" id="SC-menu" userLabel="Changes Menu (the source control's items, then the File Menu's)">
            <connections>
                <outlet property="delegate" destination="-2" id="SC-o-menu-delegate"/>
            </connections>
        </menu>
        <menu title="File" autoenablesItems="YES" id="SC-file-menu" userLabel="File Menu (after the source control's items)">
            <items>
                <menuItem title="Show Change" id="SC-m-show">
                    <connections>
                        <action selector="showChange:" target="-2" id="SC-m-show-a"/>
                    </connections>
                </menuItem>
                <menuItem title="Reveal in Project Navigator" id="SC-m-reveal">
                    <connections>
                        <action selector="revealInProjectNavigator:" target="-2" id="SC-m-reveal-a"/>
                    </connections>
                </menuItem>
            </items>
        </menu>
        <customView id="SC-root" userLabel="Source Control Navigator">
            <rect key="frame" x="0.0" y="0.0" width="240" height="700"/>
            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
            <subviews>
                <segmentedControl verticalHuggingPriority="750" id="SC-tabs" userLabel="Changes | Repositories">
                    <rect key="frame" x="8" y="672" width="224" height="24"/>
                    <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMinY="YES"/>
                    <segmentedCell key="cell" borderStyle="border" alignment="left" style="rounded" trackingMode="selectOne" id="SC-tabs-cell">
                        <font key="font" metaFont="smallSystem"/>
                        <segments>
                            <segment label="Changes" width="108" selected="YES"/>
                            <segment label="Repositories" width="108" tag="1"/>
                        </segments>
                    </segmentedCell>
                    <connections>
                        <action selector="tabChanged:" target="-2" id="SC-a-tabs"/>
                    </connections>
                </segmentedControl>
                <customView id="SC-changes" userLabel="Changes">
                    <rect key="frame" x="0.0" y="0.0" width="240" height="668"/>
                    <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                    <subviews>
                        <textField verticalHuggingPriority="750" id="SC-status" userLabel="Where It Is">
                            <rect key="frame" x="8" y="648" width="224" height="16"/>
                            <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMinY="YES"/>
                            <textFieldCell key="cell" lineBreakMode="truncatingTail" id="SC-status-cell">
                                <font key="font" metaFont="smallSystemBold"/>
                                <color key="textColor" name="labelColor" catalog="System" colorSpace="catalog"/>
                                <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                            </textFieldCell>
                        </textField>
                        <scrollView borderType="none" autohidesScrollers="YES" horizontalLineScroll="18" horizontalPageScroll="10" verticalLineScroll="18" verticalPageScroll="10" hasHorizontalScroller="NO" usesPredominantAxisScrolling="NO" id="SC-scroll">
                            <rect key="frame" x="0.0" y="96" width="240" height="548"/>
                            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                            <clipView key="contentView" drawsBackground="NO" id="SC-clip">
                                <rect key="frame" x="0.0" y="0.0" width="240" height="548"/>
                                <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                                <subviews>
                                    <outlineView verticalHuggingPriority="750" allowsExpansionToolTips="YES" columnAutoresizingStyle="lastColumnOnly" columnReordering="NO" columnResizing="NO" multipleSelection="YES" autosaveColumns="NO" rowHeight="18" rowSizeStyle="small" indentationPerLevel="12" outlineTableColumn="SC-col-name" id="SC-outline" userLabel="Groups and Their Files">
                                        <rect key="frame" x="0.0" y="0.0" width="240" height="548"/>
                                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                                        <size key="intercellSpacing" width="3" height="0.0"/>
                                        <color key="backgroundColor" name="controlBackgroundColor" catalog="System" colorSpace="catalog"/>
                                        <color key="gridColor" name="gridColor" catalog="System" colorSpace="catalog"/>
                                        <tableColumns>
                                            <tableColumn identifier="name" editable="NO" width="234" minWidth="40" maxWidth="1000" id="SC-col-name">
                                                <tableHeaderCell key="headerCell" lineBreakMode="truncatingTail" borderStyle="border" title="Changes">
                                                    <color key="textColor" name="headerTextColor" catalog="System" colorSpace="catalog"/>
                                                    <color key="backgroundColor" name="headerColor" catalog="System" colorSpace="catalog"/>
                                                </tableHeaderCell>
                                                <textFieldCell key="dataCell" lineBreakMode="truncatingMiddle" selectable="YES" title="Text Cell" id="SC-cell-name" customClass="UDBadgeTextFieldCell" userLabel="Name, with its Letter or Count">
                                                    <font key="font" metaFont="smallSystem"/>
                                                    <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                                                    <color key="backgroundColor" name="controlBackgroundColor" catalog="System" colorSpace="catalog"/>
                                                </textFieldCell>
                                                <tableColumnResizingMask key="resizingMask" resizeWithTable="YES"/>
                                            </tableColumn>
                                        </tableColumns>
                                        <connections>
                                            <action selector="showChange:" target="-2" id="SC-a-click"/>
                                            <outlet property="dataSource" destination="-2" id="SC-o-source"/>
                                            <outlet property="delegate" destination="-2" id="SC-o-delegate"/>
                                            <outlet property="menu" destination="SC-menu" id="SC-o-menu"/>
                                        </connections>
                                    </outlineView>
                                </subviews>
                                <nil key="backgroundColor"/>
                            </clipView>
                            <scroller key="horizontalScroller" hidden="YES" verticalHuggingPriority="750" horizontal="YES" id="SC-hscroll">
                                <rect key="frame" x="-100" y="-100" width="223" height="15"/>
                                <autoresizingMask key="autoresizingMask"/>
                            </scroller>
                            <scroller key="verticalScroller" hidden="YES" verticalHuggingPriority="750" horizontal="NO" id="SC-vscroll">
                                <rect key="frame" x="-100" y="-100" width="15" height="102"/>
                                <autoresizingMask key="autoresizingMask"/>
                            </scroller>
                        </scrollView>
                        <textField verticalHuggingPriority="750" id="SC-message" userLabel="Commit Message">
                            <rect key="frame" x="8" y="36" width="224" height="56"/>
                            <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMaxY="YES"/>
                            <textFieldCell key="cell" lineBreakMode="wordWrapping" selectable="YES" editable="YES" sendsActionOnEndEditing="YES" borderStyle="bezel" placeholderString="Commit message (required)" drawsBackground="YES" id="SC-message-cell">
                                <font key="font" metaFont="smallSystem"/>
                                <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                                <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                            </textFieldCell>
                        </textField>
                        <button toolTip="Commit (⌘↩)" verticalHuggingPriority="750" id="SC-commit" userLabel="Commit">
                            <rect key="frame" x="112" y="6" width="90" height="26"/>
                            <autoresizingMask key="autoresizingMask" flexibleMinX="YES" flexibleMaxY="YES"/>
                            <buttonCell key="cell" type="push" title="Commit" bezelStyle="rounded" alignment="center" lineBreakMode="truncatingTail" borderStyle="border" inset="2" id="SC-commit-cell">
                                <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES"/>
                                <font key="font" metaFont="system"/>
                                <string key="keyEquivalent" base64-UTF8="YES">
DQ
</string>
                                <modifierMask key="keyEquivalentModifierMask" command="YES"/>
                            </buttonCell>
                            <connections>
                                <action selector="commit:" target="-2" id="SC-a-commit"/>
                            </connections>
                        </button>
                        <popUpButton toolTip="Commit and Push, Amend" verticalHuggingPriority="750" id="SC-options" userLabel="Commit Options">
                            <rect key="frame" x="202" y="6" width="30" height="26"/>
                            <autoresizingMask key="autoresizingMask" flexibleMinX="YES" flexibleMaxY="YES"/>
                            <popUpButtonCell key="cell" type="push" bezelStyle="texturedRounded" alignment="left" lineBreakMode="truncatingTail" borderStyle="border" imageScaling="proportionallyDown" inset="2" pullsDown="YES" id="SC-options-cell">
                                <behavior key="behavior" lightByBackground="YES" lightByGray="YES"/>
                                <font key="font" metaFont="smallSystem"/>
                                <menu key="menu" id="SC-options-menu">
                                    <items>
                                        <menuItem hidden="YES" id="SC-options-title"/>
                                        <menuItem title="Commit and Push" id="SC-options-push">
                                            <connections>
                                                <action selector="commitAndPush:" target="-2" id="SC-options-push-a"/>
                                            </connections>
                                        </menuItem>
                                        <menuItem title="Amend" id="SC-options-amend">
                                            <connections>
                                                <action selector="amend:" target="-2" id="SC-options-amend-a"/>
                                            </connections>
                                        </menuItem>
                                    </items>
                                </menu>
                            </popUpButtonCell>
                        </popUpButton>
                    </subviews>
                </customView>
                <customView hidden="YES" id="SC-repositories" userLabel="Repositories (the source control's view)">
                    <rect key="frame" x="0.0" y="0.0" width="240" height="668"/>
                    <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                </customView>
                <textField verticalHuggingPriority="750" id="SC-empty" userLabel="No Source Control">
                    <rect key="frame" x="8" y="341" width="224" height="18"/>
                    <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMinY="YES" flexibleMaxY="YES"/>
                    <textFieldCell key="cell" lineBreakMode="truncatingTail" alignment="center" title="No Source Control" id="SC-empty-cell">
                        <font key="font" metaFont="system"/>
                        <color key="textColor" name="disabledControlTextColor" catalog="System" colorSpace="catalog"/>
                        <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                    </textFieldCell>
                </textField>
            </subviews>
            <point key="canvasLocation" x="200" y="200"/>
        </customView>
    </objects>
</document>

<?xml version="1.0" encoding="UTF-8"?>
<!--
  Scalable Vector Graphics (SVG) 1.1 – Structural RELAX NG Schema
  Source: W3C SVG 1.1 Second Edition Recommendation
  https://www.w3.org/TR/SVG11/

  This schema validates the document root element, its required namespace,
  and the structure of the most common SVG elements.  Less common elements
  are permitted via an open content model so that valid SVG 1.1 documents
  never produce false positives.
-->
<grammar xmlns="http://relaxng.org/ns/structure/1.0"
         ns="http://www.w3.org/2000/svg"
         datatypeLibrary="http://www.w3.org/2001/XMLSchema-datatypes">

  <start>
    <ref name="svg.element"/>
  </start>

  <!-- ============================================================
       Shared low-level patterns
       ============================================================ -->

  <!-- Accept any sequence of attributes from any namespace. -->
  <define name="any.attribs">
    <zeroOrMore>
      <attribute>
        <anyName/>
      </attribute>
    </zeroOrMore>
  </define>

  <!-- Accept any mix of text and elements (open content). -->
  <define name="any.content">
    <zeroOrMore>
      <choice>
        <text/>
        <element>
          <anyName/>
          <ref name="any.attribs"/>
          <ref name="any.content"/>
        </element>
      </choice>
    </zeroOrMore>
  </define>

  <!-- Common presentation / core attributes shared by most SVG elements. -->
  <define name="common.attribs">
    <optional><attribute name="id"/></optional>
    <optional><attribute name="xml:id"/></optional>
    <optional><attribute name="xml:lang"/></optional>
    <optional><attribute name="xml:space"/></optional>
    <optional><attribute name="class"/></optional>
    <optional><attribute name="style"/></optional>
    <!-- Allow any other attribute (presentation, event handlers, etc.) -->
    <zeroOrMore>
      <attribute>
        <anyName>
          <except>
            <name>id</name>
            <name>xml:id</name>
            <name>xml:lang</name>
            <name>xml:space</name>
            <name>class</name>
            <name>style</name>
          </except>
        </anyName>
      </attribute>
    </zeroOrMore>
  </define>

  <!-- ============================================================
       SVG content categories
       ============================================================ -->

  <!-- Any element that may appear inside a container or the root svg. -->
  <define name="svg.content.model">
    <zeroOrMore>
      <choice>
        <ref name="desc.element"/>
        <ref name="title.element"/>
        <ref name="metadata.element"/>
        <ref name="defs.element"/>
        <ref name="use.element"/>
        <ref name="symbol.element"/>
        <ref name="g.element"/>
        <ref name="svg.element"/>
        <ref name="image.element"/>
        <ref name="switch.element"/>
        <!-- Shape elements -->
        <ref name="path.element"/>
        <ref name="rect.element"/>
        <ref name="circle.element"/>
        <ref name="ellipse.element"/>
        <ref name="line.element"/>
        <ref name="polyline.element"/>
        <ref name="polygon.element"/>
        <!-- Text elements -->
        <ref name="text.element"/>
        <ref name="tspan.element"/>
        <ref name="tref.element"/>
        <ref name="textPath.element"/>
        <!-- Paint-server elements -->
        <ref name="linearGradient.element"/>
        <ref name="radialGradient.element"/>
        <ref name="pattern.element"/>
        <!-- Clipping / masking -->
        <ref name="clipPath.element"/>
        <ref name="mask.element"/>
        <!-- Filters -->
        <ref name="filter.element"/>
        <!-- Animation -->
        <ref name="animate.element"/>
        <ref name="set.element"/>
        <ref name="animateMotion.element"/>
        <ref name="animateColor.element"/>
        <ref name="animateTransform.element"/>
        <!-- Linking -->
        <ref name="a.element"/>
        <!-- Anything else (extension elements, foreign-namespace content) -->
        <element>
          <anyName>
            <except><nsName/></except>
          </anyName>
          <ref name="any.attribs"/>
          <ref name="any.content"/>
        </element>
        <text/>
      </choice>
    </zeroOrMore>
  </define>

  <!-- ============================================================
       Root element
       ============================================================ -->

  <define name="svg.element">
    <element name="svg">
      <ref name="common.attribs"/>
      <optional><attribute name="width"/></optional>
      <optional><attribute name="height"/></optional>
      <optional><attribute name="viewBox"/></optional>
      <optional><attribute name="preserveAspectRatio"/></optional>
      <optional><attribute name="version"/></optional>
      <optional><attribute name="baseProfile"/></optional>
      <optional><attribute name="contentScriptType"/></optional>
      <optional><attribute name="contentStyleType"/></optional>
      <optional>
        <attribute>
          <nsName ns="http://www.w3.org/1999/xlink"/>
        </attribute>
      </optional>
      <ref name="svg.content.model"/>
    </element>
  </define>

  <!-- ============================================================
       Container elements
       ============================================================ -->

  <define name="g.element">
    <element name="g">
      <ref name="common.attribs"/>
      <ref name="svg.content.model"/>
    </element>
  </define>

  <define name="defs.element">
    <element name="defs">
      <ref name="common.attribs"/>
      <ref name="svg.content.model"/>
    </element>
  </define>

  <define name="symbol.element">
    <element name="symbol">
      <ref name="common.attribs"/>
      <optional><attribute name="viewBox"/></optional>
      <optional><attribute name="preserveAspectRatio"/></optional>
      <ref name="svg.content.model"/>
    </element>
  </define>

  <define name="use.element">
    <element name="use">
      <ref name="common.attribs"/>
      <optional><attribute name="x"/></optional>
      <optional><attribute name="y"/></optional>
      <optional><attribute name="width"/></optional>
      <optional><attribute name="height"/></optional>
      <ref name="svg.content.model"/>
    </element>
  </define>

  <define name="switch.element">
    <element name="switch">
      <ref name="common.attribs"/>
      <ref name="svg.content.model"/>
    </element>
  </define>

  <define name="a.element">
    <element name="a">
      <ref name="common.attribs"/>
      <optional><attribute name="target"/></optional>
      <ref name="svg.content.model"/>
    </element>
  </define>

  <!-- ============================================================
       Descriptive elements
       ============================================================ -->

  <define name="desc.element">
    <element name="desc">
      <ref name="common.attribs"/>
      <ref name="any.content"/>
    </element>
  </define>

  <define name="title.element">
    <element name="title">
      <ref name="common.attribs"/>
      <ref name="any.content"/>
    </element>
  </define>

  <define name="metadata.element">
    <element name="metadata">
      <ref name="common.attribs"/>
      <ref name="any.content"/>
    </element>
  </define>

  <!-- ============================================================
       Shape elements
       ============================================================ -->

  <define name="path.element">
    <element name="path">
      <ref name="common.attribs"/>
      <optional><attribute name="d"/></optional>
      <optional><attribute name="pathLength"/></optional>
      <ref name="svg.content.model"/>
    </element>
  </define>

  <define name="rect.element">
    <element name="rect">
      <ref name="common.attribs"/>
      <optional><attribute name="x"/></optional>
      <optional><attribute name="y"/></optional>
      <optional><attribute name="width"/></optional>
      <optional><attribute name="height"/></optional>
      <optional><attribute name="rx"/></optional>
      <optional><attribute name="ry"/></optional>
      <ref name="svg.content.model"/>
    </element>
  </define>

  <define name="circle.element">
    <element name="circle">
      <ref name="common.attribs"/>
      <optional><attribute name="cx"/></optional>
      <optional><attribute name="cy"/></optional>
      <optional><attribute name="r"/></optional>
      <ref name="svg.content.model"/>
    </element>
  </define>

  <define name="ellipse.element">
    <element name="ellipse">
      <ref name="common.attribs"/>
      <optional><attribute name="cx"/></optional>
      <optional><attribute name="cy"/></optional>
      <optional><attribute name="rx"/></optional>
      <optional><attribute name="ry"/></optional>
      <ref name="svg.content.model"/>
    </element>
  </define>

  <define name="line.element">
    <element name="line">
      <ref name="common.attribs"/>
      <optional><attribute name="x1"/></optional>
      <optional><attribute name="y1"/></optional>
      <optional><attribute name="x2"/></optional>
      <optional><attribute name="y2"/></optional>
      <ref name="svg.content.model"/>
    </element>
  </define>

  <define name="polyline.element">
    <element name="polyline">
      <ref name="common.attribs"/>
      <optional><attribute name="points"/></optional>
      <ref name="svg.content.model"/>
    </element>
  </define>

  <define name="polygon.element">
    <element name="polygon">
      <ref name="common.attribs"/>
      <optional><attribute name="points"/></optional>
      <ref name="svg.content.model"/>
    </element>
  </define>

  <!-- ============================================================
       Text elements
       ============================================================ -->

  <define name="text.element">
    <element name="text">
      <ref name="common.attribs"/>
      <optional><attribute name="x"/></optional>
      <optional><attribute name="y"/></optional>
      <optional><attribute name="dx"/></optional>
      <optional><attribute name="dy"/></optional>
      <optional><attribute name="rotate"/></optional>
      <optional><attribute name="textLength"/></optional>
      <optional><attribute name="lengthAdjust"/></optional>
      <ref name="svg.content.model"/>
    </element>
  </define>

  <define name="tspan.element">
    <element name="tspan">
      <ref name="common.attribs"/>
      <optional><attribute name="x"/></optional>
      <optional><attribute name="y"/></optional>
      <optional><attribute name="dx"/></optional>
      <optional><attribute name="dy"/></optional>
      <optional><attribute name="rotate"/></optional>
      <optional><attribute name="textLength"/></optional>
      <optional><attribute name="lengthAdjust"/></optional>
      <ref name="svg.content.model"/>
    </element>
  </define>

  <define name="tref.element">
    <element name="tref">
      <ref name="common.attribs"/>
      <ref name="svg.content.model"/>
    </element>
  </define>

  <define name="textPath.element">
    <element name="textPath">
      <ref name="common.attribs"/>
      <optional><attribute name="startOffset"/></optional>
      <optional><attribute name="method"/></optional>
      <optional><attribute name="spacing"/></optional>
      <ref name="svg.content.model"/>
    </element>
  </define>

  <!-- ============================================================
       Image element
       ============================================================ -->

  <define name="image.element">
    <element name="image">
      <ref name="common.attribs"/>
      <optional><attribute name="x"/></optional>
      <optional><attribute name="y"/></optional>
      <optional><attribute name="width"/></optional>
      <optional><attribute name="height"/></optional>
      <optional><attribute name="preserveAspectRatio"/></optional>
      <ref name="svg.content.model"/>
    </element>
  </define>

  <!-- ============================================================
       Paint server elements
       ============================================================ -->

  <define name="stop.element">
    <element name="stop">
      <ref name="common.attribs"/>
      <optional><attribute name="offset"/></optional>
    </element>
  </define>

  <define name="linearGradient.element">
    <element name="linearGradient">
      <ref name="common.attribs"/>
      <optional><attribute name="x1"/></optional>
      <optional><attribute name="y1"/></optional>
      <optional><attribute name="x2"/></optional>
      <optional><attribute name="y2"/></optional>
      <optional><attribute name="gradientUnits"/></optional>
      <optional><attribute name="gradientTransform"/></optional>
      <optional><attribute name="spreadMethod"/></optional>
      <zeroOrMore>
        <choice>
          <ref name="stop.element"/>
          <ref name="desc.element"/>
          <ref name="title.element"/>
          <ref name="animate.element"/>
          <ref name="set.element"/>
        </choice>
      </zeroOrMore>
    </element>
  </define>

  <define name="radialGradient.element">
    <element name="radialGradient">
      <ref name="common.attribs"/>
      <optional><attribute name="cx"/></optional>
      <optional><attribute name="cy"/></optional>
      <optional><attribute name="r"/></optional>
      <optional><attribute name="fx"/></optional>
      <optional><attribute name="fy"/></optional>
      <optional><attribute name="gradientUnits"/></optional>
      <optional><attribute name="gradientTransform"/></optional>
      <optional><attribute name="spreadMethod"/></optional>
      <zeroOrMore>
        <choice>
          <ref name="stop.element"/>
          <ref name="desc.element"/>
          <ref name="title.element"/>
          <ref name="animate.element"/>
          <ref name="set.element"/>
        </choice>
      </zeroOrMore>
    </element>
  </define>

  <define name="pattern.element">
    <element name="pattern">
      <ref name="common.attribs"/>
      <optional><attribute name="x"/></optional>
      <optional><attribute name="y"/></optional>
      <optional><attribute name="width"/></optional>
      <optional><attribute name="height"/></optional>
      <optional><attribute name="patternUnits"/></optional>
      <optional><attribute name="patternContentUnits"/></optional>
      <optional><attribute name="patternTransform"/></optional>
      <optional><attribute name="viewBox"/></optional>
      <optional><attribute name="preserveAspectRatio"/></optional>
      <ref name="svg.content.model"/>
    </element>
  </define>

  <!-- ============================================================
       Clipping and masking
       ============================================================ -->

  <define name="clipPath.element">
    <element name="clipPath">
      <ref name="common.attribs"/>
      <optional><attribute name="clipPathUnits"/></optional>
      <ref name="svg.content.model"/>
    </element>
  </define>

  <define name="mask.element">
    <element name="mask">
      <ref name="common.attribs"/>
      <optional><attribute name="x"/></optional>
      <optional><attribute name="y"/></optional>
      <optional><attribute name="width"/></optional>
      <optional><attribute name="height"/></optional>
      <optional><attribute name="maskUnits"/></optional>
      <optional><attribute name="maskContentUnits"/></optional>
      <ref name="svg.content.model"/>
    </element>
  </define>

  <!-- ============================================================
       Filter element (open model — filter primitives vary widely)
       ============================================================ -->

  <define name="filter.element">
    <element name="filter">
      <ref name="common.attribs"/>
      <optional><attribute name="x"/></optional>
      <optional><attribute name="y"/></optional>
      <optional><attribute name="width"/></optional>
      <optional><attribute name="height"/></optional>
      <optional><attribute name="filterUnits"/></optional>
      <optional><attribute name="primitiveUnits"/></optional>
      <ref name="any.content"/>
    </element>
  </define>

  <!-- ============================================================
       Animation elements
       ============================================================ -->

  <define name="animate.element">
    <element name="animate">
      <ref name="common.attribs"/>
      <ref name="any.content"/>
    </element>
  </define>

  <define name="set.element">
    <element name="set">
      <ref name="common.attribs"/>
      <optional><attribute name="to"/></optional>
      <ref name="any.content"/>
    </element>
  </define>

  <define name="animateMotion.element">
    <element name="animateMotion">
      <ref name="common.attribs"/>
      <ref name="any.content"/>
    </element>
  </define>

  <define name="animateColor.element">
    <element name="animateColor">
      <ref name="common.attribs"/>
      <ref name="any.content"/>
    </element>
  </define>

  <define name="animateTransform.element">
    <element name="animateTransform">
      <ref name="common.attribs"/>
      <optional><attribute name="type"/></optional>
      <ref name="any.content"/>
    </element>
  </define>

</grammar>

<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="24127" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="NO" customObjectInstantitationMethod="direct">
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="24127"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="UDBreakpointNavigatorViewController">
            <connections>
                <outlet property="view" destination="BN-root" id="BN-o-view"/>
                <outlet property="outlineView" destination="BN-outline" id="BN-o-outline"/>
                <outlet property="removeButton" destination="BN-remove" id="BN-o-remove"/>
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application" customClass="NSObject"/>
        <menu title="Breakpoints" autoenablesItems="YES" id="BN-menu" userLabel="Breakpoints Menu">
            <items>
                <menuItem title="Edit Breakpoint…" id="BN-m-edit">
                    <connections>
                        <action selector="editBreakpoint:" target="-2" id="BN-m-edit-a"/>
                    </connections>
                </menuItem>
                <menuItem title="Disable Breakpoint" id="BN-m-enable">
                    <connections>
                        <action selector="toggleBreakpointEnabled:" target="-2" id="BN-m-enable-a"/>
                    </connections>
                </menuItem>
                <menuItem title="Delete Breakpoint" id="BN-m-delete">
                    <connections>
                        <action selector="deleteBreakpoint:" target="-2" id="BN-m-delete-a"/>
                    </connections>
                </menuItem>
                <menuItem title="Reveal in Editor" id="BN-m-show">
                    <connections>
                        <action selector="showBreakpoint:" target="-2" id="BN-m-show-a"/>
                    </connections>
                </menuItem>
                <menuItem isSeparatorItem="YES" id="BN-m-sep"/>
                <menuItem title="Enable All Breakpoints" id="BN-m-enable-all">
                    <connections>
                        <action selector="enableAllBreakpoints:" target="-2" id="BN-m-enable-all-a"/>
                    </connections>
                </menuItem>
                <menuItem title="Disable All Breakpoints" id="BN-m-disable-all">
                    <connections>
                        <action selector="disableAllBreakpoints:" target="-2" id="BN-m-disable-all-a"/>
                    </connections>
                </menuItem>
                <menuItem title="Delete All Breakpoints" id="BN-m-delete-all">
                    <connections>
                        <action selector="deleteAllBreakpoints:" target="-2" id="BN-m-delete-all-a"/>
                    </connections>
                </menuItem>
            </items>
            <connections>
                <outlet property="delegate" destination="-2" id="BN-o-menu-delegate"/>
            </connections>
        </menu>
        <customView id="BN-root" userLabel="Breakpoint Navigator">
            <rect key="frame" x="0.0" y="0.0" width="240" height="400"/>
            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
            <subviews>
                <scrollView borderType="none" autohidesScrollers="YES" horizontalLineScroll="18" horizontalPageScroll="10" verticalLineScroll="18" verticalPageScroll="10" hasHorizontalScroller="NO" usesPredominantAxisScrolling="NO" id="BN-scroll">
                    <rect key="frame" x="0.0" y="29" width="240" height="371"/>
                    <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                    <clipView key="contentView" drawsBackground="NO" id="BN-clip">
                        <rect key="frame" x="0.0" y="0.0" width="240" height="371"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <outlineView verticalHuggingPriority="750" allowsExpansionToolTips="YES" columnAutoresizingStyle="lastColumnOnly" columnReordering="NO" columnResizing="NO" multipleSelection="NO" autosaveColumns="NO" rowHeight="18" rowSizeStyle="small" indentationPerLevel="12" outlineTableColumn="BN-col-breakpoint" id="BN-outline" userLabel="Exception Filters and Breakpoints">
                                <rect key="frame" x="0.0" y="0.0" width="240" height="371"/>
                                <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                                <size key="intercellSpacing" width="3" height="0.0"/>
                                <color key="backgroundColor" name="controlBackgroundColor" catalog="System" colorSpace="catalog"/>
                                <color key="gridColor" name="gridColor" catalog="System" colorSpace="catalog"/>
                                <tableColumns>
                                    <tableColumn identifier="enabled" width="18" minWidth="18" maxWidth="18" id="BN-col-enabled">
                                        <tableHeaderCell key="headerCell" lineBreakMode="truncatingTail" borderStyle="border">
                                            <color key="textColor" name="headerTextColor" catalog="System" colorSpace="catalog"/>
                                            <color key="backgroundColor" name="headerColor" catalog="System" colorSpace="catalog"/>
                                        </tableHeaderCell>
                                        <buttonCell key="dataCell" type="check" bezelStyle="regularSquare" imagePosition="only" alignment="center" controlSize="small" inset="2" id="BN-cell-enabled">
                                            <behavior key="behavior" changeContents="YES" doesNotDimImage="YES" lightByContents="YES"/>
                                            <font key="font" metaFont="smallSystem"/>
                                        </buttonCell>
                                        <tableColumnResizingMask key="resizingMask"/>
                                    </tableColumn>
                                    <tableColumn identifier="breakpoint" editable="NO" width="213" minWidth="40" maxWidth="1000" id="BN-col-breakpoint">
                                        <tableHeaderCell key="headerCell" lineBreakMode="truncatingTail" borderStyle="border" title="Breakpoints">
                                            <color key="textColor" name="headerTextColor" catalog="System" colorSpace="catalog"/>
                                            <color key="backgroundColor" name="headerColor" catalog="System" colorSpace="catalog"/>
                                        </tableHeaderCell>
                                        <textFieldCell key="dataCell" lineBreakMode="truncatingTail" selectable="YES" title="Text Cell" id="BN-cell-breakpoint">
                                            <font key="font" metaFont="smallSystem"/>
                                            <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                                            <color key="backgroundColor" name="controlBackgroundColor" catalog="System" colorSpace="catalog"/>
                                        </textFieldCell>
                                        <tableColumnResizingMask key="resizingMask" resizeWithTable="YES"/>
                                    </tableColumn>
                                </tableColumns>
                                <connections>
                                    <action trigger="doubleAction" selector="showBreakpoint:" target="-2" id="BN-a-double"/>
                                    <outlet property="dataSource" destination="-2" id="BN-o-source"/>
                                    <outlet property="delegate" destination="-2" id="BN-o-delegate"/>
                                    <outlet property="menu" destination="BN-menu" id="BN-o-menu"/>
                                </connections>
                            </outlineView>
                        </subviews>
                        <nil key="backgroundColor"/>
                    </clipView>
                    <scroller key="horizontalScroller" hidden="YES" verticalHuggingPriority="750" horizontal="YES" id="BN-hscroll">
                        <rect key="frame" x="-100" y="-100" width="223" height="15"/>
                        <autoresizingMask key="autoresizingMask"/>
                    </scroller>
                    <scroller key="verticalScroller" hidden="YES" verticalHuggingPriority="750" horizontal="NO" id="BN-vscroll">
                        <rect key="frame" x="-100" y="-100" width="15" height="102"/>
                        <autoresizingMask key="autoresizingMask"/>
                    </scroller>
                </scrollView>
                <box verticalHuggingPriority="750" boxType="separator" id="BN-separator" userLabel="Separator">
                    <rect key="frame" x="0.0" y="26" width="240" height="5"/>
                    <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMaxY="YES"/>
                </box>
                <button toolTip="Delete Breakpoint" verticalHuggingPriority="750" id="BN-remove" userLabel="Delete Breakpoint">
                    <rect key="frame" x="4" y="4" width="22" height="20"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMaxY="YES"/>
                    <buttonCell key="cell" type="smallSquare" title="−" bezelStyle="smallSquare" alignment="center" lineBreakMode="truncatingTail" borderStyle="border" inset="2" id="BN-remove-cell">
                        <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES"/>
                        <font key="font" metaFont="system"/>
                    </buttonCell>
                    <connections>
                        <action selector="deleteBreakpoint:" target="-2" id="BN-a-remove"/>
                    </connections>
                </button>
            </subviews>
            <point key="canvasLocation" x="200" y="200"/>
        </customView>
    </objects>
</document>

# UDCodeKit and UDCode on macOS, the familiar way (gnustep-release-actions'
# macos.yml runs the same):
#
#   make -f Makefile.apple            UDCode, universal (Release), with its
#                                     frameworks, grammar bundles, Sparkle and DiagramKit;
#                                     and the frameworks as XCFrameworks
#   make -f Makefile.apple check      the tests: the text model's and the
#                                     editor's (which drive UDCode's windows)
#   make -f Makefile.apple install DESTDIR=<dir>       UDCode.app (carrying
#                                     the SQL extension's client libraries,
#                                     scripts/sql-clients.sh), and
#                                     UDPieceTable, LSPKit and UDCodeKit
#                                     .xcframework for what builds on them,
#                                     with the grammar bundles in PlugIns/ for
#                                     the apps that embed UDCodeKit (CFamily,
#                                     Git and SQL are UDCode's own)
#   make -f Makefile.apple installcheck DESTDIR=<dir>  its signature holds,
#                                     the client libraries it carries link
#                                     nothing outside it and the system, and
#                                     it starts and stays up, in a fresh home
#
# The tree-sitter runtime and the grammars are fetched at their pinned
# commits (scripts/grammars.lock) when missing; Sparkle's and DiagramKit's
# XCFrameworks are in .deps/, by the versions .github/pins.env names
# (gnustep-release-actions' scripts/deps.sh apple).

BUILD = build/apple
DERIVED = $(BUILD)/DerivedData
RELEASE = $(DERIVED)/Build/Products/Release
XCODEBUILD = xcodebuild -workspace UDPieceTable.xcworkspace -derivedDataPath $(DERIVED)
FRAMEWORKS = UDPieceTable LSPKit UDCodeKit

all: fetched clients
	@for f in Sparkle DiagramKit DiagramKitUI; do test -d .deps/$$f.xcframework \
	  || { echo "no $$f in .deps: gnustep-release-actions' scripts/deps.sh apple fetches what .github/pins.env names"; exit 1; }; done
	$(XCODEBUILD) -scheme UDCode -configuration Release -destination 'generic/platform=macOS' build
	for f in $(FRAMEWORKS); do \
	  rm -rf $(BUILD)/$$f.xcarchive $(BUILD)/$$f.xcframework; \
	  $(XCODEBUILD) -scheme $$f -configuration Release -destination 'generic/platform=macOS' \
	    -archivePath $(BUILD)/$$f.xcarchive archive SKIP_INSTALL=NO || exit 1; \
	  framework=$$(find $(BUILD)/$$f.xcarchive/Products -name $$f.framework -maxdepth 4 | head -1); \
	  xcodebuild -create-xcframework -framework "$$framework" -output $(BUILD)/$$f.xcframework || exit 1; \
	done

# The SQL extension's client libraries (it loads them when a connection
# needs them): Homebrew's libpq and MariaDB Connector/C, installed in CI,
# their headers built against and the libraries copied into the installed
# UDCode.app. Without them it builds, and says it can't reach those
# databases.
clients:
	@if [ -n "$$CI" ]; then brew install libpq mariadb-connector-c; fi

# The runtime and the grammars' C sources, the first time.
fetched:
	@ls tree-sitter/src/lib.c libvterm/src/vterm.c tree-sitter-*/src/parser.c > /dev/null 2>&1 || bash scripts/update-grammars.sh

# The test bundles are not signed: nothing ships from them.
check: fetched clients
	$(XCODEBUILD) -scheme UDPieceTable -configuration Debug -destination 'platform=macOS' test CODE_SIGNING_ALLOWED=NO
	$(XCODEBUILD) -scheme UDCode -configuration Debug -destination 'platform=macOS' test CODE_SIGNING_ALLOWED=NO

install: all
	@test -n "$(DESTDIR)" || { echo "install: give DESTDIR"; exit 1; }
	mkdir -p $(DESTDIR)
	rm -rf $(DESTDIR)/UDCode.app && ditto $(RELEASE)/UDCode.app $(DESTDIR)/UDCode.app
	bash scripts/sql-clients.sh macos $(DESTDIR)/UDCode.app
	for f in $(FRAMEWORKS); do \
	  rm -rf $(DESTDIR)/$$f.xcframework && ditto $(BUILD)/$$f.xcframework $(DESTDIR)/$$f.xcframework || exit 1; \
	done
	rm -rf $(DESTDIR)/PlugIns && mkdir -p $(DESTDIR)/PlugIns
	for b in $(RELEASE)/UDCode.app/Contents/PlugIns/TreeSitter*.bundle; do \
	  ditto $$b $(DESTDIR)/PlugIns/$$(basename $$b) || exit 1; \
	done

# The client libraries' references, each to one beside it or the system's:
# nothing of Homebrew's left (when it carries them).
installcheck:
	codesign --verify --deep --strict $(DESTDIR)/UDCode.app
	@fw=$(DESTDIR)/UDCode.app/Contents/Frameworks; \
	if [ -f $$fw/libpq.5.dylib ]; then \
	  for f in libpq.5.dylib libmariadb.3.dylib mariadb/plugin/caching_sha2_password.so; do \
	    test -f $$fw/$$f || { echo "UDCode.app carries libpq but not $$f"; exit 1; }; \
	  done; \
	  test -f $(DESTDIR)/UDCode.app/Contents/Resources/Licenses/README.txt || { echo "UDCode.app carries no Licenses/README.txt"; exit 1; }; \
	  bad=$$(for f in $$fw/*.dylib $$fw/mariadb/plugin/*.so; do otool -L $$f | tail -n +2 | awk '{print $$1}'; done \
	    | grep -v '^/usr/lib/\|^/System/\|^@loader_path/\|^@rpath/' | sort -u); \
	  [ -z "$$bad" ] || { echo "the client libraries link outside the app: $$bad"; exit 1; }; \
	  echo "UDCode: carries $$(cd $$fw && ls *.dylib mariadb/plugin/*.so | wc -l | tr -d ' ') client library files"; \
	else echo "UDCode: carries no client libraries"; fi
	home=$$(mktemp -d); log=$$(mktemp); \
	HOME=$$home CFFIXED_USER_HOME=$$home $(DESTDIR)/UDCode.app/Contents/MacOS/UDCode > $$log 2>&1 & pid=$$!; \
	sleep 10; \
	if kill -0 $$pid 2>/dev/null; then kill $$pid; echo "UDCode: up after 10s"; \
	else cat $$log; echo "UDCode exited on its own"; exit 1; fi

clean:
	rm -rf $(BUILD)

.PHONY: all fetched clients check install installcheck clean

<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="24127" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="NO" customObjectInstantitationMethod="direct">
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="24127"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="UDDebugBarViewController">
            <connections>
                <outlet property="view" destination="DB-root" id="DB-o-view"/>
                <outlet property="continueButton" destination="DB-continue" id="DB-o-continue"/>
                <outlet property="stepOverButton" destination="DB-over" id="DB-o-over"/>
                <outlet property="stepIntoButton" destination="DB-into" id="DB-o-into"/>
                <outlet property="stepOutButton" destination="DB-out" id="DB-o-out"/>
                <outlet property="stepBackButton" destination="DB-back" id="DB-o-back"/>
                <outlet property="reverseContinueButton" destination="DB-reverse" id="DB-o-reverse"/>
                <outlet property="stopButton" destination="DB-stop" id="DB-o-stop"/>
                <outlet property="statusLabel" destination="DB-status" id="DB-o-status"/>
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application" customClass="NSObject"/>
        <customView id="DB-root" userLabel="Debug Bar">
            <rect key="frame" x="0.0" y="0.0" width="640" height="26"/>
            <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMinY="YES"/>
            <subviews>
                <box verticalHuggingPriority="750" boxType="separator" id="DB-separator" userLabel="Separator">
                    <rect key="frame" x="0.0" y="23" width="640" height="5"/>
                    <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMinY="YES"/>
                </box>
                <button toolTip="Continue" verticalHuggingPriority="750" id="DB-continue" userLabel="Continue or Pause">
                    <rect key="frame" x="6" y="3" width="26" height="20"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES"/>
                    <buttonCell key="cell" type="smallSquare" title="▶" bezelStyle="smallSquare" alignment="center" lineBreakMode="truncatingTail" borderStyle="border" inset="2" id="DB-continue-cell">
                        <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES"/>
                        <font key="font" metaFont="system"/>
                    </buttonCell>
                    <connections>
                        <action selector="continueOrPause:" target="-2" id="DB-continue-action"/>
                    </connections>
                </button>
                <button toolTip="Step Over" verticalHuggingPriority="750" id="DB-over" userLabel="Step Over">
                    <rect key="frame" x="34" y="3" width="26" height="20"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES"/>
                    <buttonCell key="cell" type="smallSquare" title="↷" bezelStyle="smallSquare" alignment="center" lineBreakMode="truncatingTail" borderStyle="border" inset="2" id="DB-over-cell">
                        <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES"/>
                        <font key="font" metaFont="system"/>
                    </buttonCell>
                    <connections>
                        <action selector="stepOver:" target="-2" id="DB-over-action"/>
                    </connections>
                </button>
                <button toolTip="Step Into" verticalHuggingPriority="750" id="DB-into" userLabel="Step Into">
                    <rect key="frame" x="62" y="3" width="26" height="20"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES"/>
                    <buttonCell key="cell" type="smallSquare" title="↓" bezelStyle="smallSquare" alignment="center" lineBreakMode="truncatingTail" borderStyle="border" inset="2" id="DB-into-cell">
                        <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES"/>
                        <font key="font" metaFont="system"/>
                    </buttonCell>
                    <connections>
                        <action selector="stepInto:" target="-2" id="DB-into-action"/>
                    </connections>
                </button>
                <button toolTip="Step Out" verticalHuggingPriority="750" id="DB-out" userLabel="Step Out">
                    <rect key="frame" x="90" y="3" width="26" height="20"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES"/>
                    <buttonCell key="cell" type="smallSquare" title="↑" bezelStyle="smallSquare" alignment="center" lineBreakMode="truncatingTail" borderStyle="border" inset="2" id="DB-out-cell">
                        <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES"/>
                        <font key="font" metaFont="system"/>
                    </buttonCell>
                    <connections>
                        <action selector="stepOut:" target="-2" id="DB-out-action"/>
                    </connections>
                </button>
                <button toolTip="Step Back" verticalHuggingPriority="750" id="DB-back" userLabel="Step Back">
                    <rect key="frame" x="124" y="3" width="26" height="20"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES"/>
                    <buttonCell key="cell" type="smallSquare" title="↶" bezelStyle="smallSquare" alignment="center" lineBreakMode="truncatingTail" borderStyle="border" inset="2" id="DB-back-cell">
                        <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES"/>
                        <font key="font" metaFont="system"/>
                    </buttonCell>
                    <connections>
                        <action selector="stepBack:" target="-2" id="DB-back-action"/>
                    </connections>
                </button>
                <button toolTip="Reverse Continue" verticalHuggingPriority="750" id="DB-reverse" userLabel="Reverse Continue">
                    <rect key="frame" x="152" y="3" width="26" height="20"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES"/>
                    <buttonCell key="cell" type="smallSquare" title="◀" bezelStyle="smallSquare" alignment="center" lineBreakMode="truncatingTail" borderStyle="border" inset="2" id="DB-reverse-cell">
                        <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES"/>
                        <font key="font" metaFont="system"/>
                    </buttonCell>
                    <connections>
                        <action selector="reverseContinue:" target="-2" id="DB-reverse-action"/>
                    </connections>
                </button>
                <button toolTip="Stop" verticalHuggingPriority="750" id="DB-stop" userLabel="Stop">
                    <rect key="frame" x="186" y="3" width="26" height="20"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES"/>
                    <buttonCell key="cell" type="smallSquare" title="■" bezelStyle="smallSquare" alignment="center" lineBreakMode="truncatingTail" borderStyle="border" inset="2" id="DB-stop-cell">
                        <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES"/>
                        <font key="font" metaFont="system"/>
                    </buttonCell>
                    <connections>
                        <action selector="stop:" target="-2" id="DB-stop-action"/>
                    </connections>
                </button>
                <textField focusRingType="none" verticalHuggingPriority="750" id="DB-status" userLabel="Where It Is">
                    <rect key="frame" x="222" y="5" width="410" height="16"/>
                    <autoresizingMask key="autoresizingMask" widthSizable="YES"/>
                    <textFieldCell key="cell" lineBreakMode="truncatingMiddle" title="" id="DB-status-cell">
                        <font key="font" metaFont="smallSystem"/>
                        <color key="textColor" name="secondaryLabelColor" catalog="System" colorSpace="catalog"/>
                        <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                    </textFieldCell>
                </textField>
            </subviews>
            <point key="canvasLocation" x="200" y="200"/>
        </customView>
    </objects>
</document>

<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="24127" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="NO" customObjectInstantitationMethod="direct">
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="24127"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="UDDebugAreaViewController">
            <connections>
                <outlet property="view" destination="DA-root" id="DA-o-view"/>
                <outlet property="paneSplit" destination="DA-split-controller" id="DA-o-split-controller"/>
                <outlet property="variablesView" destination="DA-outline" id="DA-o-variables"/>
                <outlet property="consoleView" destination="DA-console-text" id="DA-o-console"/>
                <outlet property="evaluateField" destination="DA-evaluate" id="DA-o-evaluate"/>
                <outlet property="addExpressionButton" destination="DA-add-watch" id="DA-o-add-watch"/>
                <outlet property="removeExpressionButton" destination="DA-remove-watch" id="DA-o-remove-watch"/>
                <outlet property="filterField" destination="DA-filter" id="DA-o-filter"/>
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application" customClass="NSObject"/>
        <menu title="Variables" autoenablesItems="YES" id="DA-variables-menu" userLabel="Variables Menu">
            <items>
                <menuItem title="Copy Value" id="DA-m-copy">
                    <connections>
                        <action selector="copyValue:" target="-2" id="DA-m-copy-a"/>
                    </connections>
                </menuItem>
                <menuItem title="Copy as Expression" id="DA-m-copy-expression">
                    <connections>
                        <action selector="copyAsExpression:" target="-2" id="DA-m-copy-expression-a"/>
                    </connections>
                </menuItem>
                <menuItem title="Add to Watch" id="DA-m-watch">
                    <connections>
                        <action selector="addToWatch:" target="-2" id="DA-m-watch-a"/>
                    </connections>
                </menuItem>
                <menuItem title="Set Value…" id="DA-m-set">
                    <connections>
                        <action selector="setValue:" target="-2" id="DA-m-set-a"/>
                    </connections>
                </menuItem>
                <menuItem isSeparatorItem="YES" id="DA-m-sep"/>
                <menuItem title="Add Expression…" id="DA-m-add">
                    <connections>
                        <action selector="addExpression:" target="-2" id="DA-m-add-a"/>
                    </connections>
                </menuItem>
                <menuItem title="Edit Expression" id="DA-m-edit">
                    <connections>
                        <action selector="editExpression:" target="-2" id="DA-m-edit-a"/>
                    </connections>
                </menuItem>
                <menuItem title="Delete Expression" id="DA-m-remove">
                    <connections>
                        <action selector="removeExpression:" target="-2" id="DA-m-remove-a"/>
                    </connections>
                </menuItem>
                <menuItem title="Delete All Expressions" id="DA-m-remove-all">
                    <connections>
                        <action selector="removeAllExpressions:" target="-2" id="DA-m-remove-all-a"/>
                    </connections>
                </menuItem>
            </items>
            <connections>
                <outlet property="delegate" destination="-2" id="DA-o-menu-delegate"/>
            </connections>
        </menu>
        <customObject id="DA-split-controller" userLabel="Variables | Console" customClass="UDPaneSplitController">
            <connections>
                <outlet property="splitView" destination="DA-split" id="DA-o-split-view"/>
            </connections>
        </customObject>
        <customView id="DA-root" userLabel="Debug Area">
            <rect key="frame" x="0.0" y="0.0" width="800" height="220"/>
            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
            <subviews>
                <splitView dividerStyle="thin" vertical="YES" id="DA-split" userLabel="Variables | Console">
                    <rect key="frame" x="0.0" y="0.0" width="800" height="220"/>
                    <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                    <subviews>
                        <customView id="DA-variables" userLabel="Variables">
                            <rect key="frame" x="0.0" y="0.0" width="300" height="220"/>
                            <autoresizingMask key="autoresizingMask" heightSizable="YES"/>
                            <subviews>
                                <scrollView borderType="none" autohidesScrollers="YES" horizontalLineScroll="18" horizontalPageScroll="10" verticalLineScroll="18" verticalPageScroll="10" hasHorizontalScroller="NO" usesPredominantAxisScrolling="NO" id="DA-scroll">
                    <rect key="frame" x="0.0" y="29" width="300" height="191"/>
                    <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                    <clipView key="contentView" drawsBackground="NO" id="DA-clip">
                        <rect key="frame" x="0.0" y="0.0" width="300" height="191"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <outlineView verticalHuggingPriority="750" allowsExpansionToolTips="YES" columnAutoresizingStyle="lastColumnOnly" columnReordering="NO" multipleSelection="NO" autosaveColumns="NO" rowHeight="18" rowSizeStyle="small" indentationPerLevel="12" outlineTableColumn="DA-col-name" id="DA-outline" userLabel="Watches and Variables">
                                <rect key="frame" x="0.0" y="0.0" width="300" height="191"/>
                                <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                                <size key="intercellSpacing" width="3" height="0.0"/>
                                <color key="backgroundColor" name="controlBackgroundColor" catalog="System" colorSpace="catalog"/>
                                <color key="gridColor" name="gridColor" catalog="System" colorSpace="catalog"/>
                                <tableColumns>
                                    <tableColumn identifier="name" width="120" minWidth="40" maxWidth="1000" id="DA-col-name">
                                        <tableHeaderCell key="headerCell" lineBreakMode="truncatingTail" borderStyle="border" title="Name">
                                            <color key="textColor" name="headerTextColor" catalog="System" colorSpace="catalog"/>
                                            <color key="backgroundColor" name="headerColor" catalog="System" colorSpace="catalog"/>
                                        </tableHeaderCell>
                                        <textFieldCell key="dataCell" lineBreakMode="truncatingTail" selectable="YES" editable="YES" title="Text Cell" id="DA-cell-name">
                                            <font key="font" metaFont="smallSystem"/>
                                            <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                                            <color key="backgroundColor" name="controlBackgroundColor" catalog="System" colorSpace="catalog"/>
                                        </textFieldCell>
                                        <tableColumnResizingMask key="resizingMask" resizeWithTable="YES"/>
                                    </tableColumn>
                                    <tableColumn identifier="value" width="174" minWidth="40" maxWidth="1000" id="DA-col-value">
                                        <tableHeaderCell key="headerCell" lineBreakMode="truncatingTail" borderStyle="border" title="Value">
                                            <color key="textColor" name="headerTextColor" catalog="System" colorSpace="catalog"/>
                                            <color key="backgroundColor" name="headerColor" catalog="System" colorSpace="catalog"/>
                                        </tableHeaderCell>
                                        <textFieldCell key="dataCell" lineBreakMode="truncatingTail" selectable="YES" editable="YES" title="Text Cell" id="DA-cell-value">
                                            <font key="font" metaFont="smallSystem"/>
                                            <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                                            <color key="backgroundColor" name="controlBackgroundColor" catalog="System" colorSpace="catalog"/>
                                        </textFieldCell>
                                        <tableColumnResizingMask key="resizingMask" resizeWithTable="YES"/>
                                    </tableColumn>
                                </tableColumns>
                                <connections>
                                    <action trigger="doubleAction" selector="editClickedCell:" target="-2" id="DA-a-double"/>
                                    <outlet property="dataSource" destination="-2" id="DA-o-source"/>
                                    <outlet property="delegate" destination="-2" id="DA-o-delegate"/>
                                    <outlet property="menu" destination="DA-variables-menu" id="DA-o-menu"/>
                                </connections>
                            </outlineView>
                        </subviews>
                        <nil key="backgroundColor"/>
                    </clipView>
                    <scroller key="horizontalScroller" hidden="YES" verticalHuggingPriority="750" horizontal="YES" id="DA-hscroll">
                        <rect key="frame" x="-100" y="-100" width="223" height="15"/>
                        <autoresizingMask key="autoresizingMask"/>
                    </scroller>
                    <scroller key="verticalScroller" hidden="YES" verticalHuggingPriority="750" horizontal="NO" id="DA-vscroll">
                        <rect key="frame" x="-100" y="-100" width="15" height="102"/>
                        <autoresizingMask key="autoresizingMask"/>
                    </scroller>
                </scrollView>
                                <box verticalHuggingPriority="750" boxType="separator" id="DA-variables-separator" userLabel="Separator">
                                    <rect key="frame" x="0.0" y="26" width="300" height="5"/>
                                    <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMaxY="YES"/>
                                </box>
                                <button toolTip="Add Expression" verticalHuggingPriority="750" id="DA-add-watch" userLabel="Add Expression">
                                    <rect key="frame" x="4" y="4" width="22" height="20"/>
                                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMaxY="YES"/>
                                    <buttonCell key="cell" type="smallSquare" title="+" bezelStyle="smallSquare" alignment="center" lineBreakMode="truncatingTail" borderStyle="border" inset="2" id="DA-add-watch-cell">
                                        <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES"/>
                                        <font key="font" metaFont="system"/>
                                    </buttonCell>
                                    <connections>
                                        <action selector="addExpression:" target="-2" id="DA-a-add-watch"/>
                                    </connections>
                                </button>
                                <button toolTip="Delete Expression" verticalHuggingPriority="750" id="DA-remove-watch" userLabel="Delete Expression">
                                    <rect key="frame" x="27" y="4" width="22" height="20"/>
                                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMaxY="YES"/>
                                    <buttonCell key="cell" type="smallSquare" title="−" bezelStyle="smallSquare" alignment="center" lineBreakMode="truncatingTail" borderStyle="border" inset="2" id="DA-remove-watch-cell">
                                        <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES"/>
                                        <font key="font" metaFont="system"/>
                                    </buttonCell>
                                    <connections>
                                        <action selector="removeExpression:" target="-2" id="DA-a-remove-watch"/>
                                    </connections>
                                </button>
                                <searchField wantsLayer="YES" verticalHuggingPriority="750" id="DA-filter" userLabel="Filter">
                                    <rect key="frame" x="54" y="3" width="242" height="21"/>
                                    <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMaxY="YES"/>
                                    <searchFieldCell key="cell" scrollable="YES" lineBreakMode="clipping" selectable="YES" editable="YES" borderStyle="bezel" placeholderString="Filter" usesSingleLineMode="YES" bezelStyle="round" sendsSearchStringImmediately="YES" id="DA-filter-cell">
                                        <font key="font" metaFont="smallSystem"/>
                                        <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                                        <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                                    </searchFieldCell>
                                    <connections>
                                        <action selector="filterVariables:" target="-2" id="DA-a-filter"/>
                                    </connections>
                                </searchField>
                            </subviews>
                        </customView>
                        <customView id="DA-console" userLabel="Console">
                            <rect key="frame" x="301" y="0.0" width="499" height="220"/>
                            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                            <subviews>
                                <scrollView borderType="none" horizontalLineScroll="10" horizontalPageScroll="10" verticalLineScroll="10" verticalPageScroll="10" hasHorizontalScroller="NO" id="DA-console-scroll">
                                    <rect key="frame" x="0.0" y="29" width="499" height="191"/>
                                    <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                                    <clipView key="contentView" id="DA-console-clip">
                                        <rect key="frame" x="0.0" y="0.0" width="484" height="191"/>
                                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                                        <subviews>
                                            <textView editable="NO" importsGraphics="NO" verticallyResizable="YES" allowsUndo="NO" id="DA-console-text" userLabel="Console Output">
                                                <rect key="frame" x="0.0" y="0.0" width="484" height="191"/>
                                                <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                                                <color key="textColor" name="textColor" catalog="System" colorSpace="catalog"/>
                                                <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                                                <size key="minSize" width="0.0" height="0.0"/>
                                                <size key="maxSize" width="10000000" height="10000000"/>
                                            </textView>
                                        </subviews>
                                        <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                                    </clipView>
                                    <scroller key="horizontalScroller" hidden="YES" verticalHuggingPriority="750" horizontal="YES" id="DA-console-hscroll">
                                        <rect key="frame" x="-100" y="-100" width="225" height="15"/>
                                        <autoresizingMask key="autoresizingMask"/>
                                    </scroller>
                                    <scroller key="verticalScroller" verticalHuggingPriority="750" horizontal="NO" id="DA-console-vscroll">
                                        <rect key="frame" x="484" y="0.0" width="15" height="191"/>
                                        <autoresizingMask key="autoresizingMask"/>
                                    </scroller>
                                </scrollView>
                                <box verticalHuggingPriority="750" boxType="separator" id="DA-console-separator" userLabel="Separator">
                                    <rect key="frame" x="0.0" y="26" width="499" height="5"/>
                                    <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMaxY="YES"/>
                                </box>
                                <textField focusRingType="none" verticalHuggingPriority="750" id="DA-evaluate" userLabel="Evaluate">
                                    <rect key="frame" x="4" y="3" width="491" height="21"/>
                                    <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMaxY="YES"/>
                                    <textFieldCell key="cell" scrollable="YES" lineBreakMode="clipping" selectable="YES" editable="YES" sendsActionOnEndEditing="NO" borderStyle="bezel" placeholderString="Evaluate" drawsBackground="YES" usesSingleLineMode="YES" id="DA-evaluate-cell">
                                        <font key="font" metaFont="smallSystem"/>
                                        <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                                        <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                                    </textFieldCell>
                                    <connections>
                                        <action selector="evaluate:" target="-2" id="DA-a-evaluate"/>
                                    </connections>
                                </textField>
                            </subviews>
                        </customView>
                    </subviews>
                    <holdingPriorities>
                        <real value="260"/>
                        <real value="250"/>
                    </holdingPriorities>
                </splitView>
            </subviews>
            <point key="canvasLocation" x="200" y="200"/>
        </customView>
    </objects>
</document>
